{
  "name": "@earendil-works/inkling",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @earendil-works/inkling-runtime-cloudflare --filter @earendil-works/inkling-frontend run dev",
    "build": "pnpm --filter @earendil-works/inkling-frontend run build && pnpm --filter @earendil-works/inkling-runtime-cloudflare run build",
    "build:packages": "pnpm --recursive --if-present run build:package",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "test": "pnpm --recursive --if-present run test",
    "typecheck": "tsc -p scripts/tsconfig.json && pnpm --recursive --if-present run typecheck",
    "import-rfcs": "node scripts/import-rfcs.ts",
    "prepare": "husky",
    "release": "pnpm run release:prepare && node scripts/publish-release-packages.mjs",
    "release:pack": "pnpm run release:prepare && node scripts/pack-release-packages.mjs",
    "release:prepare": "pnpm run build:packages && node scripts/prepare-release-packages.mjs",
    "release:prime": "node scripts/prime-npm-packages.mjs",
    "release:trust": "node scripts/configure-npm-trust.mjs",
    "release:version": "node scripts/version-release-packages.mjs"
  },
  "devDependencies": {
    "@types/node": "25.0.3",
    "effect": "3.22.1",
    "husky": "9.1.7",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.32.1"
}
