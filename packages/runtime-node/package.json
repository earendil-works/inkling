{
  "name": "@earendil-works/inkling-runtime-node",
  "version": "0.0.1",
  "description": "Node.js runtime adapters and local server for Inkling.",
  "type": "module",
  "exports": {
    ".": "./src/server.ts"
  },
  "scripts": {
    "build:package": "rm -rf dist && tsc -p tsconfig.build.json && node ../../scripts/fix-declaration-imports.mjs dist",
    "dev": "node --watch src/main.ts",
    "prepublishOnly": "echo 'Publish from the repository root with pnpm release' >&2 && exit 1",
    "start": "node src/main.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@earendil-works/inkling-backend": "workspace:*",
    "@earendil-works/inkling-collaboration": "workspace:*",
    "@earendil-works/inkling-core": "workspace:*",
    "@earendil-works/inkling-frontend": "workspace:*",
    "@earendil-works/inkling-protocol": "workspace:*",
    "@earendil-works/inkling-renderer": "workspace:*",
    "@effect/platform": "0.97.1",
    "@effect/platform-node": "0.108.1",
    "@hono/node-server": "2.1.0",
    "effect": "3.22.1",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/ws": "8.18.1",
    "yjs": "13.6.32"
  }
}
