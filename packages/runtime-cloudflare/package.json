{
  "name": "@earendil-works/inkling-runtime-cloudflare",
  "version": "0.0.1",
  "description": "Cloudflare Worker, Durable Object, alarm, and R2 adapters for Inkling.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "build:package": "rm -rf dist && tsc -p tsconfig.build.json && node ../../scripts/fix-declaration-imports.mjs dist",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "prepublishOnly": "echo 'Publish from the repository root with pnpm release' >&2 && exit 1",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@earendil-works/inkling-backend": "workspace:*",
    "@earendil-works/inkling-collaboration": "workspace:*",
    "@earendil-works/inkling-core": "workspace:*",
    "@earendil-works/inkling-protocol": "workspace:*",
    "@earendil-works/inkling-renderer": "workspace:*",
    "effect": "3.22.1",
    "hono": "4.13.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260804.1",
    "@types/ws": "8.18.1",
    "wrangler": "4.118.0",
    "ws": "8.18.3",
    "yjs": "13.6.32"
  }
}
