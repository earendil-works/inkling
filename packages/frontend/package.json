{
  "name": "@earendil-works/inkling-frontend",
  "version": "0.0.1",
  "description": "Browser application assets for Inkling.",
  "files": [
    "dist",
    "dist-server"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./server": {
      "types": "./src/server-contract.ts",
      "default": "./dist-server/server.js"
    }
  },
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      "./server": {
        "types": "./dist-server/server.d.ts",
        "default": "./dist-server/server.js"
      }
    }
  },
  "scripts": {
    "build": "vite build && vite build --ssr",
    "build:package": "vite build && vite build --ssr",
    "dev": "vite",
    "preview": "vite preview",
    "prepublishOnly": "echo 'Publish from the repository root with pnpm release' >&2 && exit 1",
    "test": "vite build && vite build --ssr && node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-markdown": "6.5.1",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.7",
    "@earendil-works/inkling-collaboration": "workspace:*",
    "@earendil-works/inkling-core": "workspace:*",
    "@earendil-works/inkling-protocol": "workspace:*",
    "@earendil-works/inkling-renderer": "workspace:*",
    "codemirror": "6.0.2",
    "effect": "3.22.1",
    "mermaid": "11.16.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "y-codemirror.next": "0.3.5",
    "y-protocols": "1.0.7",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@earendil-works/design-tokens": "0.1.0",
    "@earendil-works/elanor-fonts": "0.1.0",
    "@earendil-works/elanor-icons-react": "0.1.0",
    "@earendil-works/elanor-react": "0.1.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "playwright-core": "1.62.1",
    "vite": "8.2.0"
  }
}
